<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=<device-width>, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <header>
        <div>
            <img class="logo" src="/images/logo.jpg" alt="Logo">
        </div>
        <ul class="headerList">
            <li> <a href="/reportes"><p>Regresar</p></a></li>
                <li> <a href="/reportes/maquina1y2"><p>Maquinas 1 y 2</p></a></li>
                <li> <a href="/reportes/maquina3"><p>Maquina 3</p></a></li>
                <li> <a href="/reportes/rochelau"><p>Rochelau</p></a></li>
                <li> <a href="/reportes/efecta"><p>Efecta</p></a></li>
                <li> <a href="/reportes/tunel"><p>Tunel de Calor</p></a></li>
                
                <li> <a href="/reportes/reporteDiario">Reporte Diario</a></li>
                <li> <a href="/reportes/reporteMensual"> Reporte Mensual</a></li>
            <li> <a href="/directory/logout"><p>Cerrar Sesion</p></a></li>
           </ul>
    </header>

    <div class="container-xxl">
        <form class="basic-form first formCatMain" action="/reportes/efecta/sendReport" enctype="x-www-form-urlencoded" method="POST" onSubmit="return confirm('Se agregara este valor, desea continuar?');">
            <span>Fecha:</span><br>
            
            <input class="custom-btn btn-7" required type="date" name="date" id="date">
<br><br>
            <span>Colaborador</span><br>
                    <select class="custom-btn btn-7 formCatMain" required name="colaborador" id="colaborador">
                        <% for(var i = 0; i < content[0].length; i++) { %>
                        <option value="<%= content[0][i] %>"><%= content[1][i] %></option>
                    <% } %>
                    </select><br><br>

            <span>Turno:</span><br>
                <select class="custom-btn btn-7" required name="turno" id="turno">
                            
                            <option value="01">Matutino</option>
                            <option value="02">Vespertino</option>
                            
                </select><br><br>

                <span class="titleCat01">Insumos</span><br><br>


                <span class="titleCat02">Polietileno BD </span><br>
                <div class="formCat01">

                <span>Lote:</span>
                <input type="text" required  maxlength="10" name="I01[lote]" id="I01[lote]">
                <span>Valor inicial:</span>
                <input type="text" required  maxlength="10" name="I01[valorI]" id="I01[valorI]">
                <span>Valor Final:</span>
                <input type="text" required  maxlength="10" name="I01[valorF]" id="I01[valorF]">
                <span>Valor Contenedor Inicial:</span>
                <input type="text"  maxlength="10" name="I01[valorContenedorI]" id="I01[valorContenedorI]">
                <span>Valor Contenedor Final:</span>
                <input type="text"  maxlength="10" name="I01[valorContenedorF]" id="I01[valorContenedorF]">
                <span>Solicitud:</span>
                <input type="text"  maxlength="10" name="I01[solicitud]" id="I01[solicitud]">
                <span>Folio de Solicitud:</span>
                <input type="text"  maxlength="10" name="I01[solicitud]" id="I01[solicitudFolio]">
                <span>Folio de Salida de Almacen:</span>
                <input type="text"  maxlength="10" name="I01[solicitud]" id="I01[solicitudFolioSalida]">
                <span>Merma:</span>
                <input type="text"  maxlength="10" name="I01[merma]" id="I01[merma]">
                <span>Materia Prima Utilizada</span>
                <input required type="text"  maxlength="10" name="I01[MPutilizada]" id="I01[MPutilizada]">
                    </div>

                <span class="titleCat02">Caja</span><br>


                <div class="formCat01">
                <span>Lote:</span>
                <input type="text" required  maxlength="10" name="I02[lote]" id="I02[lote]">
                <span>Valor inicial:</span>
                <input type="text" required  maxlength="10" name="I02[valorI]" id="I02[valorI]">
                <span>Valor Final:</span>
                <input type="text" required  maxlength="10" name="I02[valorF]" id="I02[valorF]">
                <span>Valor Contenedor Inicial:</span>
                <input type="text"  maxlength="10" name="I02[valorContenedorI]" id="I02[valorContenedorI]">
                <span>Valor Contenedor Final:</span>
                <input type="text"  maxlength="10" name="I02[valorContenedorF]" id="I02[valorContenedorF]">
                <span>Solicitud:</span>
                <input type="text"  maxlength="10" name="I02[solicitud]" id="I02[solicitud]">
                <span>Folio de Solicitud:</span>
                <input type="text"  maxlength="10" name="I02[solicitud]" id="I02[solicitudFolio]">
                <span>Folio de Salida de Almacen:</span>
                <input type="text"  maxlength="10" name="I02[solicitud]" id="I02[solicitudFolioSalida]">
                <span>Merma:</span>
                <input type="text"  maxlength="10" name="I02[merma]" id="I02[merma]">
                    </div>

                
                <span class="titleCat02">Bolsa</span><br>
                <div class="formCat01">
                <span>Lote:</span>
                <input required type="text"  maxlength="10" name="I03[lote]" id="I03[lote]">
                <span>Valor Inicial:</span>
                <input required type="text"  maxlength="10" name="I03[valorI]" id="I03[valorI]">
                <span>Valor Final:</span>
                <input required type="text"  maxlength="10" name="I03[valorF]" id="I03[valorF]">
                <span>Solicitud:</span>
                <input type="text"  maxlength="10" name="I03[solicitud]" id="I03[solicitud]">
                <span>Folio de Solicitud:</span>
                <input type="text"  maxlength="10" name="I03[solicitud]" id="I03[solicitudFolio]">
                <span>Folio de Salida de Almacen:</span>
                <input type="text"  maxlength="10" name="I03[solicitud]" id="I03[solicitudFolioSalida]">
                <span>Merma</span>
                <input type="text"  maxlength="10" name="I03[merma]" id="I03[merma]">
                <span>Materia Prima Utilizada</span>
                <input required type="text"  maxlength="10" name="I03[MPutilizada]" id="I03[MPutilizada]">
</div>


                <span class="titleCat02">Pigmento</span><br>

                <div class="formCat01">
                <span>Color:</span>
                <select required name="I04[color]" id="I04[color]">
                    <option value="N">Naranja</option>
                    <option value="AF">Azul Fuerte</option>
                    <option value="AB">Azul Bajo</option>
                    <option value="Rj">Roja</option>
                    <option value="Rs">Rosa</option>
                    <option value="Am">Amarillo</option>
                    <option value="V">Verde</option>
                    

                </select>
                <span>Lote:</span>
                <input required type="text"  maxlength="10" name="I04[lote]" id="I04[lote]">
                <span>Valor Inicial:</span>
                <input required type="text"  maxlength="10" name="I04[valorI]" id="I04[valorI]">
                <span>Valor Final:</span>
                <input required type="text"  maxlength="10" name="I04[valorF]" id="I04[valorF]">
                <span>Solicitud:</span>
                <input type="text"  maxlength="10" name="I04[solicitud]" id="I04[solicitud]">
                <span>Folio de Solicitud:</span>
                <input type="text"  maxlength="10" name="I04[solicitud]" id="I04[solicitudFolio]">
                <span>Folio de Salida de Almacen:</span>
                <input type="text"  maxlength="10" name="I04[solicitud]" id="I04[solicitudFolioSalida]">
                <span>Merma</span>
                <input type="text"  maxlength="10" name="I04[merma]" id="I04[merma]">
                <span>Materia Prima Utilizada</span>
                <input required type="text"  maxlength="10" name="I04[MPutilizada]" id="I04[MPutilizada]">
</div>







                <span class="titleCat02">Produccion Maquina Efecta</span><br><br>
<div class="formCat01">
                <span>Presentacion</span>
                <select required name="ME[presentacion]" id="ME[presentacion]">
                    <option value="T-N">Naranja</option>
                    <option value="T-A">Azul</option>
                    <option value="T-AC">Azul Cielo</option>
                    <option value="T-Rj">Roja</option>
                    <option value="T-Rs">Rosa</option>
                    <option value="T-Am">Amarilla</option>
                    <option value="T-V">Verde</option>

                </select>

                <span>Lote Produccion</span>
                <input required type="text"  maxlength="10" name="ME[lote]" id="ME[lote]">

                <span>Produccion Pzs</span>
                <input required type="text"  maxlength="10" name="ME[pzs]" id="ME[pzs]">

                <span>Produccion Bolsas</span>
                <input required type="text"  maxlength="10" name="ME[bolsas]"  id="ME[bolsas]">

                <span>Folio Entrada</span>
                <input required type="text"  maxlength="10" name="ME[folioEntrada]" id="ME[folioEntrada]">
                
                <span>Horometro Inicial</span>
                <input required type="text"  maxlength="10" name="ME[HI]" id="ME[HI]">

                <span>Horometro Final</span>
                <input required type="text"  maxlength="10" name="ME[HF]" id="ME[HF]">
</div>
                
              
                
                


            <input type="submit" value="Enviar">
        </form>

    </div>
    

</body>
</html>