<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=<device-width>, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <header>
        <div>
            <img class="logo" src="/images/logo.jpg" alt="Logo">
        </div>
        <ul class="headerList">
            <li> <a href="/directory"><p>Regresar</p></a></li>
                <li> <a href="/paros/visor"><p>Visor de Paros</p></a></li>
            <li> <a href="/directory/logout"><p>Cerrar Sesion</p></a></li>
           </ul>
    </header>

    <div class="container-xxl">

        <form class="basic-form first" action="/paros/report/addRow" enctype="x-www-form-urlencoded" method="POST" onSubmit="return confirm('Se agregara este valor, desea continuar?');">
            <p>Fecha</p>        
            <input class="custom-btn btn-7"  required type="date" name="date" id="date"><br>

                    <p>Colaborador</p>
                    <select class="custom-btn btn-7" required name="colaborador" id="colaborador">
                        <% for(var i = 0; i < content[0].length; i++) { %>
                        <option value="<%= content[0][i] %>"><%= content[1][i] %></option>
                    <% } %>
                    </select>
                    
                    <p>Maquina</p>
                        <select class="custom-btn btn-7" required name="maquina" id="maquina">
                            
                            <option value="01">Maquina 1</option>
                            <option value="02">Maquina 2</option>
                            <option value="03">Maquina 3</option>
                            <option value="04">Rochelau</option>
                            <option value="05">Efecta</option>
                            <option value="06">Tunel</option>
                        </select>

                        <p>Tipo de Paro</p>
                        <select class="custom-btn btn-7" required name="tipoParo" id="tipoParo">
                            
                            <option value="mecanico">Mecanico</option>
                            <option value="electrico">Electrico</option>
                        </select>

                        <p>Razon</p>
                        
                        <input class="custom-btn btn-7"  required minlength="4" maxlength="40" type="text" name="paro" id="paro">

                        <p>Hora Inicio</p>
                        <input class="custom-btn btn-7"  required type="time" id="horaI" name="horaI">
                        <p>Hora Fin</p>
                        <input class="custom-btn btn-7"  required type="time" id="horaF" name="horaF">


                        <br><br>
                        <input type="submit" value="Enviar">
                </form>
<br><br><br><br><br>


                <form class="basic-form first" action="/paros/maquina/agregar" enctype="x-www-form-urlencoded" method="POST" onSubmit="return confirm('Se agregara este valor, desea continuar?');">
            <p>Agregar Maquina</p>        
            <input class="custom-btn btn-7"  minlength="4" maxlength="20" required type="text" name="name" id="name"><br>



                        <br><br>
                        <input type="submit" value="Enviar">
                </form>
        
    </div>

    <br><br><br>
    

    
  
    
    

</body>
</html>