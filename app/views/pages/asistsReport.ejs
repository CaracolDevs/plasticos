<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=<device-width>, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <header>
        <div>
            <img class="logo" src="/images/logo.jpg" alt="Logo">
        </div>
        <ul class="headerList">
            <li> <a href="/asists"><p>Regresar</p></a></li>
                <li> <a href="/asists/report"><p>Reporte</p></a></li>
                <li> <a href="/asists/visor"><p>Visor de asistencias</p></a></li>
            <li> <a href="/directory/logout"><p>Cerrar Sesion</p></a></li>
           </ul>
    </header>

    <div class="container-xxl">
    

    
    <ul class="basic-ul">
        <% for(var i = 0; i < content[0].length; i++) { %>
            
            
            
            
                <form class="basic-form first" action="/asists/report/send" enctype="x-www-form-urlencoded" method="POST" onSubmit="return confirm('Este valor se borrara DIFNITIVAMENTE, esta seguro de continuar?');">
                    <input required type="date" name="date" id="date"><br>
                    <% for(var i = 0; i < content[0].length; i++) { %>
                        COLABORADOR: <%= content[1][i] %> (<%= content[0][i] %>)<br>
                        <input class="basic-input" type="text" name="id" id="id" value="<%= content[0][i] %>">
                        <input class="basic-input" type="text" name="name" id="name" value="<%= content[1][i] %>">
                        <span>Asistio?</span>
                        SI
                        <input type="checkbox" value="on" name="asist" id="asist">
                        
                        NO
                        <input type="checkbox" value="off" name="asist" id="asist"><br>
                        <span>No/Por qué?</span>
                        <input minlength="4" maxlength="20" type="text" name="reason" id="reason"><br>
                    <% } %>
                        <input type="submit" value="Enviar">
                </form>
            
            <!--
            <li >
                <span class="tag"><%= content[0][i] %> : <%= content[1][i] %> - <%= content[2][i] %> </span>
                <form class="basic-form first" action="/directory/users/delete?id=<%= content[0][i] %>" enctype="x-www-form-urlencoded" method="POST" onSubmit="return confirm('Este valor se borrara DIFNITIVAMENTE, esta seguro de continuar?');">
                    <input class="custom-btn btn-7" type="submit" value="Borrar">
                    <input class="basic-input" type="text" name="name" id="name" value="<%= content[0][i] %>">       
                </form>
               
                
                

                
            </li>
            -->
            
          <% } %>

          
    </ul>
    </div>

   
    
    

</body>
</html>